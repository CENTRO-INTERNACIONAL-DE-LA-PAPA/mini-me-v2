{
  "name": "bar",
  "description": "One bar per category, its height an aggregate of a value.",
  "slots": {
    "category": {
      "types": [
        "text",
        "boolean",
        "number"
      ]
    },
    "value": {
      "types": [
        "number"
      ]
    }
  },
  "chart": {
    "datasets": [
      {
        "name": "bars",
        "operations": [
          {
            "kind": "group",
            "by": [
              "{category}"
            ],
            "aggregates": [
              {
                "how": "{aggregate}",
                "column": "{value}",
                "name": "{aggregate}_{value}"
              }
            ]
          }
        ]
      }
    ],
    "marks": [
      {
        "mark": "barY",
        "dataset": "bars",
        "channels": [
          {
            "name": "x",
            "column": "{category}"
          },
          {
            "name": "y",
            "column": "{aggregate}_{value}"
          }
        ],
        "options": [
          {
            "name": "sort",
            "value": {
              "x": "-y"
            }
          }
        ]
      }
    ],
    "scales": [
      {
        "scale": "y",
        "label": "{aggregate} of {value}"
      }
    ]
  }
}
