{
  "name": "count_bars",
  "description": "How many rows each category has; a group stacks its counts.",
  "slots": {
    "category": {
      "types": [
        "text",
        "boolean",
        "number"
      ]
    },
    "group": {
      "types": [
        "text",
        "boolean",
        "number"
      ],
      "required": false
    }
  },
  "chart": {
    "datasets": [
      {
        "name": "counts",
        "operations": [
          {
            "kind": "group",
            "by": [
              "{category}",
              "{group}"
            ],
            "aggregates": [
              {
                "how": "count",
                "column": null,
                "name": "count"
              }
            ]
          }
        ]
      }
    ],
    "marks": [
      {
        "mark": "barY",
        "dataset": "counts",
        "channels": [
          {
            "name": "x",
            "column": "{category}"
          },
          {
            "name": "y",
            "column": "count"
          },
          {
            "name": "fill",
            "column": "{group}"
          }
        ],
        "options": [
          {
            "name": "sort",
            "value": {
              "x": "-y"
            }
          }
        ]
      }
    ],
    "scales": [
      {
        "scale": "y",
        "label": "Count of {category}"
      }
    ]
  }
}
